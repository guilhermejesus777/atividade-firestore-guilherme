# =====================================================================
# Configuração opcional da atividade (copie para .env se precisar)
# Por padrão, o programa procura o arquivo serviceAccountKey.json
# na pasta atividade-firestore/.
# =====================================================================

# Caminho alternativo para a chave da conta de serviço
# (relativo à pasta atividade-firestore/ ou absoluto).
# FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Nome da coleção no Firestore. Padrão: alunos
# FIRESTORE_COLLECTION=alunos

# Alternativa para produção: JSON da conta de serviço em uma linha.
# Prefira usar a variável de ambiente do servidor, nunca commitar o .env.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Emulador local do Firestore (opcional, não precisa de credenciais reais)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_PROJECT_ID=demo-atividade
